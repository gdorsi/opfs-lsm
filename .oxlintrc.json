{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/wasm/**",
    "target/**",
    ".scratch/**",
    ".claude/**",
    ".agents/**",
    "**/.vitepress/cache/**"
  ],
  "rules": {
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off"
  },
  "overrides": [
    {
      "files": [
        "bench/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Benchmarks must run on the browser's real IndexedDB."
              }
            ]
          }
        ]
      }
    }
  ]
}
