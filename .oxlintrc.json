{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/wasm/**",
    "target/**",
    ".scratch/**",
    ".claude/**",
    ".agents/**",
    "**/.vitepress/cache/**",
    "site/stageshow/kit/**"
  ],
  "rules": {
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off"
  },
  "overrides": [
    {
      "files": [
        "bench/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Benchmarks must run on the browser's real IndexedDB."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "Date",
          "performance",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "The whiteboard model is headless. React belongs in src/app."
              },
              {
                "group": [
                  "@opfs-lsm/*",
                  "y-indexeddb",
                  "fake-indexeddb",
                  "fake-indexeddb/*",
                  "../persistence/*"
                ],
                "message": "Only src/persistence imports a storage package. The model reaches storage through DocStorage."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/env.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "performance",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/digest.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "yjs",
                "message": "The oracle replays patches on a plain Map. It must not depend on Yjs."
              }
            ],
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "The whiteboard model is headless. React belongs in src/app."
              },
              {
                "group": [
                  "./doc.ts",
                  "./board.ts",
                  "../persistence/*"
                ],
                "message": "The oracle must not depend on the Y.Doc layer or on storage."
              },
              {
                "group": [
                  "@opfs-lsm/*",
                  "y-indexeddb",
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Only src/persistence imports a storage package. The model reaches storage through DocStorage."
              }
            ]
          }
        ]
      }
    }
  ]
}
