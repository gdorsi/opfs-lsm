{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/wasm/**",
    "target/**",
    ".scratch/**",
    ".claude/**",
    ".agents/**",
    "**/.vitepress/cache/**",
    "site/stageshow/kit/**"
  ],
  "rules": {
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off"
  },
  "overrides": [
    {
      "files": [
        "bench/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Benchmarks must run on the browser's real IndexedDB."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "Date",
          "performance",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "The whiteboard model is headless. React belongs in src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/env.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "performance",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/digest.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "yjs",
                "message": "The oracle replays patches on a plain Map. It must not depend on Yjs."
              }
            ],
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "The whiteboard model is headless. React belongs in src/app."
              },
              {
                "group": [
                  "./doc.ts",
                  "./board.ts",
                  "../persistence/*"
                ],
                "message": "The oracle must not depend on the Y.Doc layer or on storage."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/linearlite-tanstackdb/src/model/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "document",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "navigator",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "location",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "BroadcastChannel",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "EventSource",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "localStorage",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "performance",
            "property": "mark",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react-dom/*",
                  "@tanstack/react-*",
                  "../app/*",
                  "../ui/*",
                  "../routes/*"
                ],
                "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/pages-fate-automerge/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@opfs-lsm/*",
                  "@nkzw/fate-indexeddb",
                  "@automerge/automerge-repo-storage-*"
                ],
                "message": "Only src/storage/ imports storage packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/pages-fate-automerge/src/model/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./*",
                  "!@nkzw/fate",
                  "!@nkzw/fate/persistence",
                  "!@automerge/automerge",
                  "!@automerge/automerge-repo"
                ],
                "message": "The model runs unchanged in the app, the bench and Node: it imports only fate, Automerge and automerge-repo."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "BroadcastChannel",
          "MessageChannel",
          "Worker",
          "SharedWorker",
          "fetch",
          "WebSocket"
        ]
      }
    },
    {
      "files": [
        "examples/pages-fate-automerge/src/storage/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "examples/pages-fate-automerge/src/testing/reference.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!../model/types.ts"
                ],
                "message": "The oracle imports only types from model/types.ts, so no model bug can leak into it."
              }
            ]
          }
        ]
      }
    }
  ]
}
