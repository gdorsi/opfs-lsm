{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "vitest"
  ],
  "jsPlugins": [
    "./scripts/oxlint-plugin.mjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/wasm/**",
    "packages/kv/engine/**",
    "target/**",
    ".scratch/**",
    ".claude/**",
    ".agents/**",
    "**/.vitepress/cache/**",
    "site/stageshow/kit/**"
  ],
  "rules": {
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off"
  },
  "overrides": [
    {
      "files": [
        "bench/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Benchmarks must run on the browser's real IndexedDB."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "bench/contenders/tracker/**",
        "bench/contenders/tanstack-live/**",
        "bench/page/tracker.ts",
        "bench/page/tanstack-live.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Benchmarks must run on the browser's real IndexedDB."
              },
              {
                "group": [
                  "**/datasets/*/history*",
                  "**/datasets/*/oracle*",
                  "**/datasets/*/index*"
                ],
                "message": "A contender sees only its dataset's types.ts: the history and the oracle stay out of contender code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "bench/datasets/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Benchmarks must run on the browser's real IndexedDB."
              },
              {
                "group": [
                  "**/contenders/**",
                  "**/page/tracker*",
                  "@opfs-lsm/*",
                  "dexie",
                  "@tanstack/*"
                ],
                "message": "A dataset's history and oracle share no code with a contender and import no storage library."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "Date",
          "performance",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "The whiteboard model is headless. React belongs in src/app."
              },
              {
                "group": [
                  "@opfs-lsm/*",
                  "fake-indexeddb",
                  "fake-indexeddb/*",
                  "../persistence/*"
                ],
                "message": "Only src/persistence imports a storage package. The model reaches storage through DocStorage."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/app/**",
        "examples/whiteboard-yjs/src/routes/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@opfs-lsm/*",
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Only src/persistence imports a storage package. The app reaches storage through openStorage."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/app/core/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "Date",
          "performance",
          "setTimeout",
          "clearTimeout",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@tanstack/*",
                  "@opfs-lsm/*",
                  "fake-indexeddb",
                  "fake-indexeddb/*",
                  "../../persistence/*"
                ],
                "message": "src/app/core runs in Node tests. The DOM boundary is src/app/stage.tsx; storage is src/persistence."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/env.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "requestAnimationFrame",
          "cancelAnimationFrame",
          "HTMLElement",
          "PointerEvent",
          "KeyboardEvent",
          "performance",
          "setInterval",
          "clearInterval",
          "BroadcastChannel"
        ]
      }
    },
    {
      "files": [
        "examples/whiteboard-yjs/src/model/digest.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "yjs",
                "message": "The oracle replays patches on a plain Map. It must not depend on Yjs."
              }
            ],
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "The whiteboard model is headless. React belongs in src/app."
              },
              {
                "group": [
                  "./doc.ts",
                  "./board.ts",
                  "../persistence/*"
                ],
                "message": "The oracle must not depend on the Y.Doc layer or on storage."
              },
              {
                "group": [
                  "@opfs-lsm/*",
                  "fake-indexeddb",
                  "fake-indexeddb/*"
                ],
                "message": "Only src/persistence imports a storage package. The model reaches storage through DocStorage."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/linearlite-tanstackdb/src/model/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "document",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "navigator",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "location",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "BroadcastChannel",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "EventSource",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          },
          {
            "name": "localStorage",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "performance",
            "property": "mark",
            "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
          }
        ]
      }
    },
    {
      "files": [
        "examples/linearlite-tanstackdb/src/model/**"
      ],
      "excludeFiles": [
        "**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react-dom/*",
                  "@tanstack/react-*",
                  "../app/*",
                  "../ui/*",
                  "../routes/*"
                ],
                "message": "linearlite's model runs headless: the app passes in what it needs from the browser."
              },
              {
                "group": [
                  "../backends/*",
                  "@opfs-lsm/*"
                ],
                "message": "linearlite's model reaches storage only through the Backend it is opened with."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/notes-manager-automerge/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@opfs-lsm/*",
                  "@automerge/automerge-repo-storage-*"
                ],
                "message": "Only src/storage/ imports storage packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "examples/notes-manager-automerge/src/editor/**"
      ],
      "excludeFiles": [
        "**/view.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./*",
                  "!../model/types.ts",
                  "!prosemirror-*",
                  "prosemirror-view"
                ],
                "message": "The editor's schema, binding and commands run in Node tests: they import only ProseMirror (not prosemirror-view) and the model's types."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "BroadcastChannel",
          "MessageChannel",
          "Worker",
          "SharedWorker",
          "fetch",
          "WebSocket"
        ]
      }
    },
    {
      "files": [
        "examples/notes-manager-automerge/src/model/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./*",
                  "!@automerge/automerge",
                  "!@automerge/automerge-repo"
                ],
                "message": "The model runs unchanged in the app and in Node tests: it imports only Automerge and automerge-repo."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "location",
          "localStorage",
          "sessionStorage",
          "indexedDB",
          "BroadcastChannel",
          "MessageChannel",
          "Worker",
          "SharedWorker",
          "fetch",
          "WebSocket"
        ]
      }
    },
    {
      "files": [
        "examples/notes-manager-automerge/src/storage/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "examples/notes-manager-automerge/src/testing/reference.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!../model/types.ts"
                ],
                "message": "The oracle imports only types from model/types.ts, so no model bug can leak into it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**"
      ],
      "rules": {
        "opfs-lsm/text-decoder-ignore-bom": "error"
      }
    }
  ]
}
