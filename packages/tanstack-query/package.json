{
  "name": "@opfs-lsm/tanstack-query",
  "version": "0.3.0",
  "description": "TanStack Query persister storage on @opfs-lsm/kv, in the slot of idb-keyval",
  "keywords": [
    "tanstack-query",
    "react-query",
    "tanstack",
    "opfs",
    "persistence",
    "offline",
    "browser"
  ],
  "homepage": "https://github.com/gdorsi/opfs-lsm#readme",
  "bugs": {
    "url": "https://github.com/gdorsi/opfs-lsm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdorsi/opfs-lsm.git",
    "directory": "packages/tanstack-query"
  },
  "author": "Guido D'Orsi",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && tsx --conditions=opfs-lsm-source --test tests/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opfs-lsm/kv": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/query-persist-client-core": "^5.0.0"
  },
  "devDependencies": {
    "@tanstack/query-async-storage-persister": "5.108.4",
    "@tanstack/query-core": "5.108.4",
    "@tanstack/query-persist-client-core": "5.108.4",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
