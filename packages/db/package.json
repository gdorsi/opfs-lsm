{
  "name": "@opfs-lsm/db",
  "version": "0.4.0",
  "description": "A database for web apps on @opfs-lsm/docstore: validated collections and live queries in TanStack DB's query syntax, read through declared indexes",
  "keywords": [
    "opfs",
    "indexeddb",
    "database",
    "live-query",
    "browser",
    "storage"
  ],
  "homepage": "https://github.com/gdorsi/opfs-lsm#readme",
  "bugs": {
    "url": "https://github.com/gdorsi/opfs-lsm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdorsi/opfs-lsm.git",
    "directory": "packages/db"
  },
  "author": "Guido D'Orsi",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "opfs-lsm-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "opfs-lsm-source": "./src/solid.ts",
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opfs-lsm/docstore": "workspace:*",
    "@opfs-lsm/kv": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^2.0.3"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.3",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "solid-js": "^2.0.3",
    "typescript": "^5.9.0",
    "valibot": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
