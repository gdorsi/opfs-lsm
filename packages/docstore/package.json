{
  "name": "@opfs-lsm/docstore",
  "version": "0.1.0",
  "description": "A document store with declared indexes, paged queries, snapshot reads and a change feed, on @opfs-lsm/kv",
  "keywords": [
    "opfs",
    "indexeddb",
    "database",
    "document-store",
    "browser",
    "storage"
  ],
  "homepage": "https://github.com/gdorsi/opfs-lsm#readme",
  "bugs": {
    "url": "https://github.com/gdorsi/opfs-lsm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdorsi/opfs-lsm.git",
    "directory": "packages/docstore"
  },
  "author": "Guido D'Orsi",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opfs-lsm/kv": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
