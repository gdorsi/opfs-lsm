{
  "name": "@opfs-lsm/spaces",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first database on @opfs-lsm/kv: typed collections, end-to-end encrypted sync, and a server that cannot read the data",
  "keywords": ["local-first", "sync", "e2ee", "opfs", "database", "browser"],
  "homepage": "https://github.com/gdorsi/opfs-lsm#readme",
  "bugs": { "url": "https://github.com/gdorsi/opfs-lsm/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/gdorsi/opfs-lsm.git", "directory": "packages/spaces" },
  "author": "Guido D'Orsi",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" },
    "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@opfs-lsm/kv": "workspace:*"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  }
}
