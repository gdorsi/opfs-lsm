  },
  "peerDependencies": {
    "@tanstack/db": "^1.0.0-rc.1.4"
  },
  "devDependencies": {
    "@tanstack/db": "1.0.0-rc.1.4",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
