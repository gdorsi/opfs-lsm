{
  "name": "@opfs-lsm/tanstack-db",
  "version": "0.1.0",
  "description": "TanStack DB collections persisted in @opfs-lsm/kv and synced between tabs",
  "keywords": [
    "tanstack-db",
    "tanstack",
    "opfs",
    "persistence",
    "browser"
  ],
  "homepage": "https://github.com/gdorsi/opfs-lsm#readme",
  "bugs": {
    "url": "https://github.com/gdorsi/opfs-lsm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdorsi/opfs-lsm.git",
    "directory": "packages/tanstack-db"
  },
  "author": "Guido D'Orsi",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
