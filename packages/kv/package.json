{
  "name": "@opfs-lsm/kv",
  "version": "0.5.0",
  "description": "Browser KV: shared IDB WAL + OPFS LSM (SST ingest)",
  "keywords": [
    "opfs",
    "indexeddb",
    "lsm",
    "key-value",
    "storage",
    "browser",
    "wasm"
  ],
  "homepage": "https://github.com/gdorsi/opfs-lsm#readme",
  "bugs": {
    "url": "https://github.com/gdorsi/opfs-lsm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdorsi/opfs-lsm.git",
    "directory": "packages/kv"
  },
  "author": "Guido D'Orsi",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/host/shared-worker.js",
    "./dist/host/metered-worker.js",
    "./dist/testing.js"
  ],
  "exports": {
    ".": {
      "opfs-lsm-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tuple": {
      "opfs-lsm-source": "./src/tuple.ts",
      "types": "./dist/tuple.d.ts",
      "import": "./dist/tuple.js"
    },
    "./testing": {
      "opfs-lsm-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./shared-worker": {
      "opfs-lsm-source": "./src/host/shared-worker.ts",
      "types": "./dist/host/shared-worker.d.ts",
      "import": "./dist/host/shared-worker.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "sh engine/build.sh",
    "build:wasm-checked": "tsx checked/build.ts",
    "build": "sh -c 'test -f wasm/engine.wasm || pnpm run build:wasm' && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "two-tab": "pnpm run build && tsx scripts/two-tab.ts",
    "kill-chrome": "pnpm run build && tsx scripts/kill-chrome.ts",
    "power-loss-chrome": "pnpm run build && tsx scripts/power-loss-chrome.ts",
    "probe:wasm-memory": "tsx scripts/wasm-memory.ts",
    "engine:gate": "tsx scripts/engine-gate.ts",
    "lint:engine": "tsx checked/lint-engine.ts",
    "mutant-canary": "tsx scripts/mutant-canary.ts",
    "formal:ingest-visibility": "tsx formal/ingest-visibility/check.ts",
    "formal:kv": "tsx formal/run-all.ts",
    "formal:wal-over-sst": "tsx formal/wal-over-sst/check.ts",
    "formal:view-pin": "tsx formal/view-pin/check.ts",
    "formal:compact-preserve": "tsx formal/compact-preserve/check.ts",
    "formal:update-exact": "tsx formal/update-exact/check.ts",
    "formal:power-loss": "tsx formal/power-loss/check.ts",
    "formal:crash-table": "tsx formal/crash-table/check.ts",
    "formal:reclaim-hold": "tsx formal/reclaim-hold/check.ts",
    "formal:gen-switch": "tsx formal/gen-switch/check.ts",
    "fuzz:corpus": "tsx fuzz/make-corpus.ts",
    "fuzz:jazzer": "tsx fuzz/jazzer/run.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@jazzer.js/core": "4.0.0",
    "assemblyscript": "0.28.20",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
