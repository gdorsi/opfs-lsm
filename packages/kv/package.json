{
  "name": "@opfs-lsm/kv",
  "version": "0.1.0",
  "description": "Browser KV: per-tab OPFS logs ingested by a SharedWorker into an OPFS LSM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./shared-worker": {
      "types": "./dist/host/shared-worker.d.ts",
      "import": "./dist/host/shared-worker.js"
    },
    "./log-worker": {
      "types": "./dist/log/log-worker.d.ts",
      "import": "./dist/log/log-worker.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "sh ../../crates/engine-wasm/build.sh",
    "build": "sh -c 'test -f wasm/engine.wasm || pnpm run build:wasm' && tsc -p tsconfig.json",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "two-tab": "pnpm run build && tsx scripts/two-tab.ts",
    "kill-chrome": "pnpm run build && tsx scripts/kill-chrome.ts",
    "log-queue": "pnpm run build && tsx scripts/log-queue.ts",
    "formal:ingest-visibility": "tsx formal/ingest-visibility/check.ts",
    "formal:kv": "tsx formal/run-all.ts",
    "formal:own-over-runs": "tsx formal/own-over-runs/check.ts",
    "formal:view-pin": "tsx formal/view-pin/check.ts",
    "formal:compact-preserve": "tsx formal/compact-preserve/check.ts",
    "formal:ingest-plan": "tsx formal/ingest-plan/check.ts",
    "fuzz:corpus": "tsx fuzz/make-corpus.ts",
    "fuzz:jazzer": "tsx fuzz/jazzer/run.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@jazzer.js/core": "4.0.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
