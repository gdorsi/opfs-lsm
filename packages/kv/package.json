{
  "name": "@opfs-lsm/kv",
  "version": "0.1.0",
  "description": "Browser KV: shared IDB WAL + OPFS LSM (SST ingest)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./shared-worker": {
      "types": "./dist/host/shared-worker.d.ts",
      "import": "./dist/host/shared-worker.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/engine-wasm --target web --out-dir ../../packages/kv/wasm --release",
    "build": "sh -c 'test -f wasm/engine_wasm_bg.wasm && test -f wasm/engine_wasm.js || pnpm run build:wasm' && tsc -p tsconfig.json",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "two-tab": "pnpm run build && tsx scripts/two-tab.ts",
    "formal:ingest-visibility": "tsx formal/ingest-visibility/check.ts",
    "formal:kv": "tsx formal/run-all.ts",
    "formal:wal-over-sst": "tsx formal/wal-over-sst/check.ts",
    "formal:view-pin": "tsx formal/view-pin/check.ts",
    "formal:compact-preserve": "tsx formal/compact-preserve/check.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
