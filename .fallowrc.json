{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/proof/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/formal/**/check.ts",
    "packages/*/formal/run-all.ts",
    "examples/*/scripts/**/*.ts",
    "bench/cli.ts",
    "bench/page/main.ts",
    "bench/workloads/*/*.ts",
    "bench/contenders/*/*.ts"
  ],
  "ignoreBinaries": [
    "wasm-pack"
  ],
  "ignoreDependencies": [
    "@automerge/automerge-repo-storage-indexeddb"
  ],
  "ignoreExports": [
    {
      "file": "packages/kv/src/store/engine.ts",
      "exports": [
        "encodeSst",
        "decodeSst"
      ]
    }
  ],
  "usedClassMembers": [
    "page",
    "clear",
    "orderBy",
    "uningestedBytes"
  ]
}
