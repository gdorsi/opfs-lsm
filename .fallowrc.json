{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/proof/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/formal/**/check.ts",
    "packages/*/formal/run-all.ts",
    "packages/*/fuzz/make-corpus.ts",
    "packages/*/fuzz/jazzer/*.ts",
    "packages/docstore/tests/usage.ts",
    "examples/*/scripts/**/*.ts",
    "examples/*/src/service-worker.js",
    "examples/linearlite-docstore/src/seed-worker.ts",
    "bench/cli.ts",
    "bench/page/main.ts",
    "bench/probes/*.ts",
    "bench/workloads/*/*.ts",
    "bench/contenders/*/*.ts",
    "docs/research/opfs-worker-probes/*.js",
    "docs/research/opfs-worker-probes/*.mjs",
    "docs/research/android-device-run/*.mjs"
  ],
  "ignorePatterns": [
    "site/stageshow/kit/**",
    "packages/kv/engine/**"
  ],
  "ignoreBinaries": [
    "wasm-pack",
    "agent-browser",
    "cloudflared"
  ],
  "ignoreDependencies": [
    "lucide-react",
    "vue",
    "@automerge/automerge-repo-storage-indexeddb"
  ],
  "ignoreExports": [
    {
      "file": "packages/kv/src/store/engine.ts",
      "exports": [
        "encodeRun",
        "encodeSst"
      ]
    }
  ]
}
