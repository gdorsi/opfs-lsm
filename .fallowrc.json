{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/proof/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/formal/**/check.ts",
    "packages/*/formal/run-all.ts",
    "packages/*/fuzz/make-corpus.ts",
    "packages/*/fuzz/jazzer/*.ts",
    "packages/docstore/tests/usage.ts",
    "examples/*/scripts/**/*.ts",
    "bench/cli.ts",
    "bench/page/main.ts",
    "bench/probes/*.ts",
    "bench/workloads/*/*.ts",
    "bench/contenders/*/*.ts",
    "docs/research/opfs-worker-probes/*.js",
    "docs/research/opfs-worker-probes/*.mjs"
  ],
  "ignoreBinaries": [
    "wasm-pack"
  ],
  "ignoreDependencies": [
    "@automerge/automerge-repo-storage-indexeddb",
    "@tanstack/react-virtual"
  ],
  "ignoreExports": [
    {
      "file": "examples/linearlite/src/domain/model.ts",
      "exports": [
        "STATUS_LABELS",
        "PRIORITY_LABELS",
        "SyncState"
      ]
    },
    {
      "file": "examples/linearlite/src/client/hooks.ts",
      "exports": [
        "useBoardColumn",
        "useStatusCounts",
        "useIssue",
        "useIssueDetail",
        "IssueDetail"
      ]
    },
    {
      "file": "examples/linearlite/src/client/filter.ts",
      "exports": [
        "SORT_FIELDS"
      ]
    },
    {
      "file": "packages/kv/src/store/engine.ts",
      "exports": [
        "encodeRun",
        "encodeSst",
        "decodeSst"
      ]
    }
  ],
  "usedClassMembers": [
    "uningestedBytes"
  ]
}
