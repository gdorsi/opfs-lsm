{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/proof/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/formal/**/check.ts",
    "packages/*/formal/run-all.ts",
    "packages/*/fuzz/make-corpus.ts",
    "packages/*/fuzz/jazzer/*.ts",
    "packages/docstore/tests/usage.ts",
    "examples/*/scripts/**/*.ts",
    "examples/*/bench/*.ts",
    "examples/*/bench/*.js",
    "examples/*/src/service-worker.js",
    "examples/*/demo/main.tsx",
    "bench/cli.ts",
    "bench/page/main.ts",
    "bench/probes/*.ts",
    "bench/workloads/*/*.ts",
    "bench/contenders/*/*.ts",
    "docs/research/opfs-worker-probes/*.js",
    "docs/research/opfs-worker-probes/*.mjs"
  ],
  "ignorePatterns": [
    "site/stageshow/kit/**"
  ],
  "ignoreBinaries": [
    "wasm-pack",
    "agent-browser"
  ],
  "ignoreDependencies": [
    "@automerge/automerge-repo-storage-indexeddb",
    "lucide-react",
    "vue"
  ],
  "ignoreExports": [
    {
      "file": "packages/kv/src/store/engine.ts",
      "exports": [
        "encodeRun",
        "encodeSst"
      ]
    }
  ]
}
