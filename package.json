{
  "name": "opfs-async",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @opfs-lsm/kv test:unit && pnpm --filter @opfs-lsm/collections test",
    "test:kv": "pnpm --filter @opfs-lsm/kv test:unit",
    "test:collections": "pnpm --filter @opfs-lsm/collections test",
    "bench": "pnpm --filter @opfs-lsm/kv bench",
    "bench:browser": "pnpm --filter @opfs-lsm/kv bench:browser"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
